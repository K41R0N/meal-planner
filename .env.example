# This file is documentation only. server/index.ts does not load dotenv files;
# inject values through your shell, container runtime, or approved deployment environment.

# Enable the preview import route only after approved access controls are in place.
IMPORT_API_ENABLED=false

# Optional server controls: leave commented to use the code defaults.
# STATIC_ROOT=dist
# PORT=3000

# Preferred managed LLM endpoint/key pair. Keep both server-only and blank in source.
MANUS_API_URL=
MANUS_API_KEY=

# Alternative managed LLM endpoint/key pair used only when the matching MANUS_* value is absent.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
